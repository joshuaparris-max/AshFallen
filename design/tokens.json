{
  "$comment": "Single source of truth for the Josh OS visual language. scripts/build-tokens.mjs generates design/tokens.css from this file. Native code (compositor, Settings) should read this same file so the web prototype and the real desktop can never drift apart.",
  "meta": {
    "name": "Josh OS Design Tokens",
    "version": "0.1.0"
  },
  "color": {
    "bg":         { "light": "#f3f3f1", "dark": "#141719" },
    "surface":    { "light": "#ffffff", "dark": "#1c2023" },
    "surface2":   { "light": "#e9e9e5", "dark": "#23282c" },
    "surface3":   { "light": "#dededa", "dark": "#2b3136" },
    "border":     { "light": "#d4d4cf", "dark": "#2f353b" },
    "text":       { "light": "#1a1d20", "dark": "#e7eaec" },
    "textMuted":  { "light": "#5e656c", "dark": "#97a0a8" },
    "textFaint":  { "light": "#8b9199", "dark": "#6b747c" },
    "accent":     { "light": "#2c8a70", "dark": "#48c39f" },
    "accentText": { "light": "#ffffff", "dark": "#0d1114" },
    "danger":     { "light": "#b23a2c", "dark": "#e5695b" },
    "warning":    { "light": "#a8700f", "dark": "#dda43c" }
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "999px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px"
  },
  "font": {
    "ui": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, 'Cascadia Code', 'SF Mono', Menlo, Consolas, monospace",
    "sizeSm": "12px",
    "sizeMd": "13px",
    "sizeLg": "15px",
    "sizeXl": "20px"
  },
  "shadow": {
    "window": "0 12px 32px rgba(0,0,0,.28), 0 2px 8px rgba(0,0,0,.18)",
    "panel": "0 4px 16px rgba(0,0,0,.20)"
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "ease": "cubic-bezier(.2,.8,.3,1)"
  },
  "chrome": {
    "menubarHeight": "28px",
    "dockHeight": "60px",
    "titlebarHeight": "32px",
    "snapThreshold": "12"
  }
}
