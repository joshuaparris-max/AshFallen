#!/usr/bin/env bash
set -u

serial="/dev/ttyS0"
emit() {
  local message="$1"
  logger -t josh-os-browser-probe "$message"
  if [[ -w "$serial" ]]; then
    printf '%s\r\n' "$message" >"$serial"
  fi
}

emit_log() {
  local prefix="$1"
  local path="$2"
  [[ -r "$path" ]] || return 0
  while IFS= read -r line; do
    emit "$prefix $line"
  done <"$path"
}

ready=0
for _ in $(seq 1 60); do
  browser_ok=0
  audio_ok=0
  keyring_ok=0

  if pgrep -u josh -x chromium >/dev/null 2>&1 || pgrep -u josh -f '/usr/lib/chromium/chromium' >/dev/null 2>&1; then
    browser_ok=1
  fi

  if runuser -u josh -- env XDG_RUNTIME_DIR=/run/user/1000 pactl info >/dev/null 2>&1 &&
     runuser -u josh -- env XDG_RUNTIME_DIR=/run/user/1000 pactl get-default-sink 2>/dev/null | grep -q .; then
    audio_ok=1
  fi

  if pgrep -u josh -x gnome-keyring-daemon >/dev/null 2>&1; then
    keyring_ok=1
  fi

  if (( browser_ok && audio_ok && keyring_ok )); then
    ready=1
    break
  fi
  sleep 1
done

if (( ! ready )); then
  emit "JOSHOS_BROWSER_READY_FAIL"
  exit 1
fi

emit "JOSHOS_BROWSER_READY"

profile="/home/josh/.config/chromium-josh-browser"
profile_ready=0
for _ in $(seq 1 30); do
  if [[ -s "$profile/Local State" ]]; then
    profile_ready=1
    break
  fi
  sleep 1
done
if (( ! profile_ready )); then
  emit "JOSHOS_BROWSER_PROFILE_FAIL"
  exit 1
fi
emit "JOSHOS_BROWSER_PROFILE_READY"

if /usr/local/lib/josh-os/browser-media-probe >/tmp/josh-os-browser-media-probe.log 2>&1; then
  emit "JOSHOS_BROWSER_MEDIA_OK"
else
  emit "JOSHOS_BROWSER_MEDIA_FAIL"
  emit_log "JOSHOS_BROWSER_MEDIA_DIAG" /tmp/josh-os-browser-media-probe.log
  exit 1
fi

network_preconditions=0
for _ in $(seq 1 60); do
  nm_state="$(nmcli -t -f STATE general 2>/dev/null || true)"
  ntp_state="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
  if printf '%s\n' "$nm_state" | grep -Eq '^connected' && [[ "$ntp_state" == "yes" ]]; then
    network_preconditions=1
    break
  fi
  sleep 1
done

if (( ! network_preconditions )); then
  emit "JOSHOS_NETWORK_READY_FAIL"
  /usr/local/bin/josh-network-check >/tmp/josh-os-network-check.log 2>&1 || true
  emit_log "JOSHOS_NETWORK_DIAG" /tmp/josh-os-network-check.log
  exit 1
fi

if /usr/local/bin/josh-network-check >/tmp/josh-os-network-check.log 2>&1; then
  emit "JOSHOS_NETWORK_READY"
else
  emit "JOSHOS_NETWORK_READY_FAIL"
  emit_log "JOSHOS_NETWORK_DIAG" /tmp/josh-os-network-check.log
  exit 1
fi

if [[ -e /run/josh-os-persistence-active ]]; then
  profile_probe="$profile/.josh-persistence-probe"
  downloads_probe="/home/josh/Downloads/.josh-persistence-probe"
  if [[ -f "$profile_probe" && -f "$downloads_probe" ]]; then
    emit "JOSHOS_BROWSER_PERSISTENCE_OK"
  else
    printf 'persistent Chromium profile probe\n' >"$profile_probe"
    printf 'persistent Downloads probe\n' >"$downloads_probe"
    chown josh:josh "$profile_probe" "$downloads_probe"
    chmod 0600 "$profile_probe" "$downloads_probe"
    sync
    emit "JOSHOS_BROWSER_PERSISTENCE_PRIMED"
  fi
else
  emit "JOSHOS_BROWSER_PERSISTENCE_INACTIVE"
fi
