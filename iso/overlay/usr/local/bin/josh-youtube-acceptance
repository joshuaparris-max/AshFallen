#!/usr/bin/env bash
set -euo pipefail

state_dir="$HOME/.local/state/josh-os/youtube-acceptance"
state_file="$state_dir/state"
report="$HOME/Downloads/josh-youtube-acceptance.txt"
profile="$HOME/.config/chromium-josh-browser"

usage() {
  cat <<'EOF'
Usage:
  josh-youtube-acceptance start
  josh-youtube-acceptance mark-playback
  josh-youtube-acceptance verify
  josh-youtube-acceptance confirm
  josh-youtube-acceptance status

This is a human-assisted acceptance test. It never reads or exports cookie
contents, passwords, tokens or other browser secrets.
EOF
}

boot_id() { cat /proc/sys/kernel/random/boot_id; }

require_persistence() {
  if [[ ! -e /run/josh-os-persistence-active ]]; then
    echo "acceptance: JOSH-DATA persistence is not active" >&2
    exit 1
  fi
}

cookie_db() {
  local candidate
  for candidate in "$profile/Default/Network/Cookies" "$profile/Default/Cookies"; do
    if [[ -s "$candidate" ]]; then
      printf "%s\n" "$candidate"
      return 0
    fi
  done
  return 1
}

write_state() {
  local phase="$1"
  local started_boot="${2:-}"
  local played_boot="${3:-}"
  local verify_boot="${4:-}"
  install -d -m 0700 "$state_dir"
  umask 077
  cat >"$state_file" <<EOF
phase=$phase
started_boot=$started_boot
played_boot=$played_boot
verify_boot=$verify_boot
EOF
}

load_state() {
  [[ -f "$state_file" ]] || { echo "acceptance: no active test; run start first" >&2; exit 1; }
  # File is generated by this script with fixed keys and boot UUID values.
  # shellcheck disable=SC1090
  source "$state_file"
}

preflight() {
  /usr/local/bin/josh-network-check
  /usr/local/bin/josh-os-browser-diagnostics
}

action="${1:-status}"
case "$action" in
  start)
    require_persistence
    preflight
    current="$(boot_id)"
    write_state started "$current" "" ""
    /usr/local/bin/josh-os-browser https://www.youtube.com/ >/tmp/josh-youtube-acceptance-browser.log 2>&1 &
    disown || true
    cat <<EOF
Preflight passed and YouTube was opened.

1. Sign in to YouTube.
2. Play a normal video.
3. Confirm with your own ears that audio is audible.
4. Then run: josh-youtube-acceptance mark-playback
EOF
    ;;
  mark-playback)
    require_persistence
    load_state
    [[ "${phase:-}" == "started" ]] || { echo "acceptance: expected phase started" >&2; exit 1; }
    current="$(boot_id)"
    [[ "$current" == "${started_boot:-}" ]] || { echo "acceptance: playback must be marked before reboot" >&2; exit 1; }
    db=""
    for _ in $(seq 1 30); do
      db="$(cookie_db 2>/dev/null || true)"
      [[ -n "$db" ]] && break
      sleep 1
    done
    [[ -n "$db" ]] || { echo "acceptance: Chromium cookie database was not created" >&2; exit 1; }
    write_state played "$started_boot" "$current" ""
    sync
    printf "Playback/sign-in step recorded on boot %s. Reboot Josh OS now, then run: josh-youtube-acceptance verify\n" "$current"
    ;;
  verify)
    require_persistence
    load_state
    [[ "${phase:-}" == "played" ]] || { echo "acceptance: expected phase played" >&2; exit 1; }
    current="$(boot_id)"
    [[ "$current" != "${played_boot:-}" ]] || { echo "acceptance: a reboot has not occurred since playback was marked" >&2; exit 1; }
    preflight
    [[ -f "$profile/.josh-persistence-probe" ]] || { echo "acceptance: browser profile persistence marker is missing" >&2; exit 1; }
    [[ -f "$HOME/Downloads/.josh-persistence-probe" ]] || { echo "acceptance: Downloads persistence marker is missing" >&2; exit 1; }
    db="$(cookie_db 2>/dev/null || true)"
    [[ -n "$db" ]] || { echo "acceptance: persisted Chromium cookie database is missing" >&2; exit 1; }
    write_state verify-ready "$started_boot" "$played_boot" "$current"
    /usr/local/bin/josh-os-browser https://www.youtube.com/ >/tmp/josh-youtube-acceptance-browser.log 2>&1 &
    disown || true
    cat <<EOF
Persistence and browser preflight passed after a different boot.

Confirm in the visible browser that YouTube is still signed in and play a video
long enough to confirm audio is still audible. Then run:

  josh-youtube-acceptance confirm
EOF
    ;;
  confirm)
    require_persistence
    load_state
    [[ "${phase:-}" == "verify-ready" ]] || { echo "acceptance: expected phase verify-ready" >&2; exit 1; }
    current="$(boot_id)"
    [[ "$current" == "${verify_boot:-}" ]] || { echo "acceptance: confirmation must occur on the verification boot" >&2; exit 1; }
    db="$(cookie_db 2>/dev/null || true)"
    [[ -n "$db" ]] || { echo "acceptance: Chromium cookie database is missing" >&2; exit 1; }
    install -d -m 0700 "$(dirname "$report")"
    {
      echo "Josh OS YouTube acceptance: PASS"
      echo "Recorded: $(date --iso-8601=seconds)"
      echo "Initial boot: $started_boot"
      echo "Playback boot: $played_boot"
      echo "Verification boot: $verify_boot"
      echo "Chromium: $(chromium --version 2>/dev/null || echo unknown)"
      echo "Kernel: $(uname -srmo)"
      echo "Persistent profile: $profile"
      echo "Cookie DB present: yes"
      echo "Human confirmation: signed in after reboot and audible YouTube playback"
    } >"$report"
    chmod 0600 "$report"
    write_state passed "$started_boot" "$played_boot" "$verify_boot"
    printf "PASS recorded without exporting browser secrets: %s\n" "$report"
    ;;
  status)
    if [[ -f "$state_file" ]]; then
      cat "$state_file"
      [[ -f "$report" ]] && printf "report=%s\n" "$report"
    else
      echo "No YouTube acceptance run is active."
    fi
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
